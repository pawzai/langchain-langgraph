# Copy to .env and adjust as needed. All values have working defaults.

OLLAMA_BASE_URL=http://localhost:11434

# Reasoning model. Set FAST_MODE=true to use CHAT_MODEL_FAST instead.
CHAT_MODEL=qwen3:14b
CHAT_MODEL_FAST=qwen3:8b
FAST_MODE=false

EMBEDDING_MODEL=qwen3-embedding:0.6b

# Max times the graph may loop back to re-plan when evidence is insufficient.
MAX_INVESTIGATION_LOOPS=2

# --- Retrieval pipeline ---

# hybrid = dense vectors fused with BM25 keyword search. vector = dense only (the V1 behaviour,
# kept so `python eval/run_eval.py` can measure what hybrid search is actually worth).
RETRIEVAL_MODE=hybrid

# Candidates pulled from each retriever before fusion, and chunks handed to the model after it.
DENSE_K=20
SPARSE_K=20
FINAL_K=4

# Cross-encoder reranking. The model is ~80 MB and downloads from Hugging Face on first use.
# Set RERANK_ENABLED=false for a fully offline first run.
RERANK_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Chunks scoring below this are dropped rather than padded into the context. Cross-encoder
# logits are unbounded, so negative values are normal and this floor is intentionally lenient.
MIN_RERANK_SCORE=-6.0

# Chunking. Raise the size for prose-heavy corpora, lower it for dense reference material.
CHUNK_SIZE=900
CHUNK_OVERLAP=120
